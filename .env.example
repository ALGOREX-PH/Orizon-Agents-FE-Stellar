# Copy to .env.local (local dev) or set on Vercel / host in prod.
# All values below are the defaults baked into the code; override per environment.

# Base URL of the FastAPI backend.
# - Local:  http://localhost:8000
# - Vercel: https://your-backend.onrender.com  (or fly.dev, etc.)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Stellar network — defaults target testnet.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Mainnet — uncomment the three lines below (and comment the testnet ones) to
# target the public network. The public Soroban RPC is rate-limited; use a
# dedicated provider for production traffic.
# NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
